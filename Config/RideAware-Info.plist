<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Keeps an active microphone/speech audio session running while the screen is locked.
	     Whether capture and spoken alerts actually continue in the background must be verified
	     on a physical device (see docs/DEVICE_TEST_MATRIX.md). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
