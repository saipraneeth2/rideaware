# RideAware environment template (Milestone 3 group voice / network transport).
# Copy to Config/secrets.env (git-ignored). Nothing in Milestone 1 reads these values.
# Never commit real values. Client apps must not embed long-lived provider secrets:
# issue short-lived tokens from your own backend instead.

# Group presence / messaging backend (not yet chosen)
RIDEAWARE_GROUP_API_BASE_URL=
# Voice provider (not yet chosen). Example names only; fill in per the provider's docs.
RIDEAWARE_VOICE_PROVIDER=
RIDEAWARE_VOICE_TOKEN_ENDPOINT=
